{
  "providers": {
    "chameleon-claude": {
      "baseUrl": "https://claude-relay.example.com",
      "apiKey": "replace-with-your-claude-api-key",
      "modelOverrides": {
        "claude-opus-4-6": {
          "maxTokens": 8192
        }
      }
    },
    "chameleon-codex": {
      "baseUrl": "https://codex-relay.example.com/v1",
      "apiKey": "replace-with-your-codex-api-key",
      "modelOverrides": {
        "gpt-5.3-codex": {
          "maxTokens": 8192,
          "samplingParams": {
            "max_output_tokens": 8192
          }
        }
      }
    }
  }
}
